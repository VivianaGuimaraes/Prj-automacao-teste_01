{
    // Configurações do Language Server do Robot Framework
    "robot.language-server.python": "${workspaceFolder}/.venvP310/Scripts/python.exe",
    "robot.language-server.args": [],

    // Se usar pastas extras para Resources, Libraries, etc.
    "robot.pythonpath": [
        "${workspaceFolder}/Resources",
        "${workspaceFolder}/libraries"
    ],

    // linha nova configuração
    "robot.python.executable": "C:\\Python310\\python.exe",

    // Variáveis globais
    "robot.variables": {
        "SITE_DIVERSO": "https://seusite.com"
    },

    // Ativa linting do Robocop no VS Code
    "robot.lint.robocop.enabled": true,
    "robot.lint.robocop.executable": "${workspaceFolder}/.venvP310/Scripts/robocop.exe",

    // Estilo de indentação e salvamento
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.eol": "\r\n",
    "files.autoSave": "onFocusChange",

    // Ajustes finais para boa prática
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    // Formatação automática para arquivos .robot
    "[robot]": {
        "editor.formatOnSave": true
    },

    "robot.lint.robocop.rules": {
        "enabled": [],
        "disabled": [
            "0203",  // Missing documentation in suite
            "0302",  // Keyword name does not follow case convention
            "0503",  // Keyword has too many keywords inside
            "1002",  // Missing trailing blank line
            "1003",  // Invalid number of empty lines between sections
            "0913",  // No tests in resource file
            "0503"
        ]
    }
}